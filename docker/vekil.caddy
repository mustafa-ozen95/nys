# Ağ Yönetim Sistemi — ters vekil parçası
#
# Bu dosya PANELİN KENDİSİNE aittir. Merkezî bir dosyada alan adı listesi
# tutulmuyor; her panel kendi yönlendirmesini taşır ve vekil bu dizini
# `import` eder.
#
# Kurulum (sunucuda BİR KEZ, panel başına; <site-dizini> vekilin site
# dosyalarını import ettiği dizindir):
#
#     sudo cp docker/vekil.caddy <site-dizini>/nys.caddy
#     sudo sed -i 's/panel-a.ornek.test/GERCEK.ALAN.ADI/' <site-dizini>/nys.caddy
#     docker exec <vekil-konteyneri> caddy reload --config /etc/caddy/Caddyfile
#
# Vekilin nasıl kurulacağı docker/README.md'de.

panel-a.ornek.test {
	reverse_proxy nys:80 {
		# Panel bu başlıklara bakarak isteğin HTTPS olduğunu anlar. Caddy
		# X-Forwarded-Proto'yu kendiliğinden ekler; Host'u da geçirmek
		# gerekiyor, çünkü panel mutlak adresleri ondan üretiyor.
		header_up Host {host}
		header_up X-Real-IP {remote_host}

		# Tarayıcıdan SSH/RDP oturumları WebSocket'tir ve SAATLERCE açık
		# kalabilir. Varsayılan okuma süresi dolunca oturum sessizce düşerdi.
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}
