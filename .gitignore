# Ortam dosyasının HER kopyası; .env.example bilerek dışarıda tutulur.
# Elle alınmış .env yedekleri gerçek parolaları taşır ve bir kez commit
# edilirse geçmişten temizlenmesi ayrı bir iş olur.
.env.*
!.env.example

# Sürüm arşivleri: içlerinde .env var ve depoya girmemeli.
*.zip

# Yerel envanter dosyası (gerçek cihaz kayıtları; bkz. .ai/rules/seeders.md).
/database/seeders/local/inventory.php

# Kökte duran bir kurulum yapılandırma dosyası APP_KEY, veritabanı parolası,
# Guacamole sırrı ve SMTP parolası taşıyabilir; ayarlar kökteki .env'dedir
# (örneği .env.example). İkisi de ASLA izlenmez.
/nys.conf

# Vekilsiz deneme (docker-compose.override.example.yml'den kopyalanır).
docker-compose.override.yml
# İmajda derlemede yazılır (docker/Dockerfile); depoya girmez.
/SURUM
