# ============================================================================
#  nys (NYS — Juniper Ağ Yönetim Paneli) — kurulum değişkenleri
# ============================================================================
#  docker compose ile:   cp .env.example .env   (izin 600; git'e ve imaja girmez)
#  Bir platformda (NineDeploy, Coolify, Dokploy...): bu adları platformun
#  değişken ekranına girin, sırları "gizli" işaretleyin.
#
#  Boş bırakılan satır konteynere BOŞ değer olarak geçer; varsayılanı
#  kullanmak için satırı silin ya da başına # koyun.
# ============================================================================

# ----------------------------------------------------------------------------
#  Uygulama
# ----------------------------------------------------------------------------
#  ⚠ APP_KEY'İ YEDEKLEYİN: switch parolaları, SNMP community'leri, sunucu
#  kimlikleri ve Ayarlar → Veritabanı'nın bağlantı dosyası BU ANAHTARLA
#  şifrelenir; kaybolursa veritabanı duruyor olsa bile hiçbiri okunamaz.
#  Boşsa ilk açılışta üretilir ve storage/app/app-key.txt'de saklanır
#  (değeri günlüğe yazılmaz); oradan alıp buraya yazın:
#      docker compose exec panel cat /uygulama/storage/app/app-key.txt
APP_KEY=
APP_URL=https://panel-a.ornek.test
# APP_NAME=NYS
# APP_TIMEZONE=Europe/Istanbul

# ----------------------------------------------------------------------------
#  Veritabanı
# ----------------------------------------------------------------------------
#  Varsayılan: compose'taki db servisi (MariaDB 11.4). Parolayı siz verin;
#  ilk açılışta kullanıcı ve veritabanı bununla kurulur.
DB_PASSWORD=
# DB_DATABASE=nsm
# DB_USERNAME=nsm
#
#  Dışarıdaki ya da platformun yönettiği bir MariaDB/MySQL için adresini
#  verin ve db servisini kapatın:
# DB_HOST=
# DB_PORT=3306
# VT_KOPYA=0

# ----------------------------------------------------------------------------
#  Kimlik Yönetim Merkezi ile giriş (SSO)
# ----------------------------------------------------------------------------
#  KIMLIK_ACIK=true ise giriş ekranında "merkez ile giriş" düğmesi çıkar.
#  İstemci kimliği ve sırrı merkezdeki "İstemciler" ekranından; dönüş adresi
#  oradaki kayıtla BİREBİR aynı olmalı (port dâhil). Bildirim sırrı boşsa
#  erişim kaldırma beş dakikalık eşitleme turunu bekler. Merkezin sertifikası
#  genel bir otoriteden değilse kök sertifikası KIMLIK_KOK'a (PEM).
# KIMLIK_ACIK=false
# KIMLIK_ADRES=https://merkez.ornek.test
# KIMLIK_ISTEMCI=
# KIMLIK_ISTEMCI_SIR=
# KIMLIK_DONUS=https://panel-a.ornek.test/giris/merkez/geri
# KIMLIK_BILDIRIM_SIR=
# KIMLIK_AD="Kimlik Yönetim Merkezi"
# KIMLIK_KOK=
#  Merkezdeki YÖNETİCİ rolü buraya da geçsin mi? Varsayılan hayır: merkezde
#  rol dağıtabilen biri kendini burada da (cihazlara yazabilen) yönetici
#  yapabilirdi.
# KIMLIK_YONETICI_DEVRI=false

# ----------------------------------------------------------------------------
#  Denetim kaydı
# ----------------------------------------------------------------------------
#  Satırlar HMAC-SHA256 ile zincirlenir. APP_KEY'DEN AYRI TUTUN: boşsa
#  APP_KEY kullanılır ve APP_KEY döndürüldüğü gün bütün geçmiş "kırık"
#  görünür. Üretmek için:
#      openssl rand -hex 32
ACTIVITY_CHAIN_KEY=

# ----------------------------------------------------------------------------
#  Cihazlar ve sunucular
# ----------------------------------------------------------------------------
#  Switch'lerin yapılandırma yedeğini gönderdiği adres (Junos archive-sites).
#  Kimlik içerir; boşsa panel cihaza yedek adresi yazmaz.
# ARCHIVAL_SITE=ftp://kullanici:parola@192.0.2.6/
#
#  Windows sunucularda kurtarma hesabı (WinRM). Varsayılan kapalı: yeni yerel
#  yönetici uzaktan yetki alamıyor (LocalAccountTokenFilterPolicy); o kaydı
#  1 yapan kurulumlarda açılır (bkz. DESTEK.md).
# SUNUCU_WINRM_KURTARMA=false

# ----------------------------------------------------------------------------
#  İzleme (Zabbix) — yalnızca OKUNUR
# ----------------------------------------------------------------------------
# ZABBIX_ENABLED=true
# ZABBIX_URL=
# ZABBIX_API_TOKEN=

# ----------------------------------------------------------------------------
#  Anons yetki denetimi (RPKI ROA + IRR route)
# ----------------------------------------------------------------------------
#  Konteynerin 443 (RIPEstat) ve 43 (RADB whois) portlarına dışa çıkışı olmalı.
# ANNOUNCEMENT_AUTHORIZATION=true
# ANNOUNCEMENT_ASN=

# ----------------------------------------------------------------------------
#  Uzak oturumlar
# ----------------------------------------------------------------------------
#  SSH (ttyd) her zaman çalışır. RDP için Guacamole gerekir ve YALNIZCA sır
#  verilmişse başlatılır (verilmezse 200 MB'lık JVM hiç açılmaz). Sır 16
#  BAYTLIK onaltılık bir dizedir (32 karakter; json-auth AES-128 kullanır):
#      openssl rand -hex 16
# GUACAMOLE_SECRET=
# GUACAMOLE_USER=guacadmin

# ----------------------------------------------------------------------------
#  Görünüm
# ----------------------------------------------------------------------------
#  Merkez ve paneller aynı üst alan adındaysa gece/gündüz seçimi paylaşılır.
# TEMA_ALANI=.ornek.test

# ----------------------------------------------------------------------------
#  Güncelleme kontrolü (Ayarlar → Güncelleme)
# ----------------------------------------------------------------------------
#  Panel her sabah son başarılı imaj derlemesine bakar; YALNIZCA bakar.
#  Fine-grained jeton: yalnız panel depoları, Contents ve Actions: read.
# GUNCELLEME_JETONU=

# ----------------------------------------------------------------------------
#  İlk yönetici — YALNIZCA ilk açılışta, kullanıcı tablosu boşken
# ----------------------------------------------------------------------------
#  Adres boşsa admin@nys.local kullanılır. Parola boşsa rastgele üretilir ve
#  storage/app/ilk-parola.txt'ye yazılır (değeri günlüğe yazılmaz); giriş yapıp
#  değiştirdikten sonra o dosyayı silin. Sonradan hesap açmak için (parola
#  sorulur, komut satırına yazılmaz):
#      docker compose exec panel php artisan ag:yonetici-ekle
# ADMIN_NAME="Sistem Yöneticisi"
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
#  Örnek veri: admin dışındaki yerleşik roller (network, teknik); yalnız ilk
#  açılışta etkili.
# ORNEK_VERI=false

# ----------------------------------------------------------------------------
#  E-posta — prefix anons talepleri buradan gider
# ----------------------------------------------------------------------------
#  "log" seçilirse (varsayılan) mailler GÖNDERİLMEZ, yalnızca günlüğe yazılır.
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
# MAIL_FROM_ADDRESS=noc@ornek.test
# MAIL_FROM_NAME="Ağ Yönetim Paneli"

# ----------------------------------------------------------------------------
#  Kurulum
# ----------------------------------------------------------------------------
#  Konteyner ve hacim adlarının öneki; aynı sunucuda ikinci kurulumda değişir.
# ONEK=nys
#  Deneme ya da taşıma kurulumu: konteynerler cihazlara ve dışarıya bağlanamaz.
# AG_YALITIMI=true
